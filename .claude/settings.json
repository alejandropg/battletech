{
  "env": {
    "ENABLE_LSP_TOOL": "true"
  },
  "includeGitInstructions": false,
  "permissions": {
    "deny": [
      "Read(./.idea/**)",
      "Grep(./.idea/**)",
      "Edit(./.idea/**)",
      "Read(./.kotlin/**)",
      "Grep(./.kotlin/**)",
      "Edit(./.kotlin/**)",
      "Read(./.gradle/**)",
      "Grep(./.gradle/**)",
      "Edit(./.gradle/**)",
      "Read(./.junie/**)",
      "Grep(./.junie/**)",
      "Edit(./.junie/**)",
      "Read(./.vscode/**)",
      "Grep(./.vscode/**)",
      "Edit(./.vscode/**)"
    ]
  },
  "enabledPlugins": {
    "kotlin-lsp@claude-plugins-official": true
  }
}
